<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules (Android 12+). The Komari API key ciphertext never leaves the
   device; see backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/komari_secret.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/komari_secret.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
