<?xml version="1.0" encoding="utf-8"?>
<!--
   Self-hosted Komari panels are often reached as http://IP:port, so cleartext traffic is allowed.
   The Komari settings page shows a prominent warning when an API key would travel over HTTP.
   Only system CAs are trusted (no user-installed CAs).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
